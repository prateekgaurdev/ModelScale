---
// GlobalLeadersGrid.astro — dual-direction infinite marquee
---

<section class="section-gap-sm bg-[#050608] border-t border-white/[0.06] overflow-hidden">
  <div class="container-xl mb-12 text-center">
    <p class="reveal eyebrow mb-4">Enterprise Trust</p>
    <h2 class="reveal delay-1 text-headline line-anim text-white">
      Trusted by Disruptors &<br>
      <span class="text-gradient-blue">Fortune 500 Market Leaders.</span>
    </h2>
  </div>

  <!-- ROW 1 — scrolls left -->
  <div class="marquee-mask overflow-hidden mb-4">
    <div class="flex gap-4 animate-marquee">
      {[
        ['/assets/images/home-global-leader-ikea-logo.svg', 'IKEA'],
        ['/assets/images/home-global-leader-google-icon.svg', 'Google'],
        ['/assets/images/home-global-leader-bcg-icon.svg', 'BCG'],
        ['/assets/images/home-global-leader-kfc-icon.svg', 'KFC'],
        ['/assets/images/home-global-leader-americana.svg', 'Americana Group'],
        ['/assets/images/home-global-leader-fridays-icon.svg', 'TGI Fridays'],
        ['/assets/images/home-global-leader-dominos-icon.svg', 'Dominos'],
        ['/assets/images/home-global-leader-pvr-icon.svg', 'PVR Cinemas'],
        ['/assets/images/home-global-leader-krispy-kreme-icon.svg', 'Krispy Kreme'],
        ['/assets/images/flynas-card-logo.svg', 'Flynas'],
        ['/assets/images/home-global-leader-moo-icon.svg', 'MOO'],
        ['/assets/images/adidas-new-logo.svg', 'Adidas'],
        // duplicate for seamless loop
        ['/assets/images/home-global-leader-ikea-logo.svg', 'IKEA'],
        ['/assets/images/home-global-leader-google-icon.svg', 'Google'],
        ['/assets/images/home-global-leader-bcg-icon.svg', 'BCG'],
        ['/assets/images/home-global-leader-kfc-icon.svg', 'KFC'],
        ['/assets/images/home-global-leader-americana.svg', 'Americana Group'],
        ['/assets/images/home-global-leader-fridays-icon.svg', 'TGI Fridays'],
        ['/assets/images/home-global-leader-dominos-icon.svg', 'Dominos'],
        ['/assets/images/home-global-leader-pvr-icon.svg', 'PVR Cinemas'],
        ['/assets/images/home-global-leader-krispy-kreme-icon.svg', 'Krispy Kreme'],
        ['/assets/images/flynas-card-logo.svg', 'Flynas'],
        ['/assets/images/home-global-leader-moo-icon.svg', 'MOO'],
        ['/assets/images/adidas-new-logo.svg', 'Adidas'],
      ].map(([src, alt]) => (
        <div class="flex items-center justify-center shrink-0 h-14 px-7 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:border-[#FF5B2E]/30 transition-colors duration-300 group cursor-default">
          <img
            src={src}
            alt={alt}
            class="max-h-6 max-w-[100px] w-auto h-auto object-contain filter grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-400"
            onerror="this.closest('div').style.display='none'"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- ROW 2 — scrolls right (reverse) -->
  <div class="marquee-mask overflow-hidden">
    <div class="flex gap-4 animate-marquee-r">
      {[
        ['/assets/images/home-global-leader-honda.svg', 'Honda'],
        ['/assets/images/home-global-leader-tim-hortons-icon.svg', 'Tim Hortons'],
        ['/assets/images/home-global-leader-virgin-mobile-icon.svg', 'Virgin Mobile'],
        ['/assets/images/home-global-leader-tvs-credit-icon.svg', 'TVS Credit'],
        ['/assets/images/home-global-leader-yum-icon.svg', 'Yum!'],
        ['/assets/images/home-global-leader-wimpy-icon.svg', 'Wimpy'],
        ['/assets/images/home-global-leader-sixth-street.svg', 'Sixth Street'],
        ['/assets/images/home-global-leader-super-she-icon.svg', 'Super She'],
        ['/assets/images/home-global-leader-hardees-icon.svg', 'Hardees'],
        ['/assets/images/home-global-leader-empire-hotels-icon.svg', 'Empire Hotels'],
        ['/assets/images/home-global-leader-american-express.svg', 'AmEx'],
        ['/assets/images/ikea-home-logo.svg', 'IKEA'],
        // duplicate
        ['/assets/images/home-global-leader-honda.svg', 'Honda'],
        ['/assets/images/home-global-leader-tim-hortons-icon.svg', 'Tim Hortons'],
        ['/assets/images/home-global-leader-virgin-mobile-icon.svg', 'Virgin Mobile'],
        ['/assets/images/home-global-leader-tvs-credit-icon.svg', 'TVS Credit'],
        ['/assets/images/home-global-leader-yum-icon.svg', 'Yum!'],
        ['/assets/images/home-global-leader-wimpy-icon.svg', 'Wimpy'],
        ['/assets/images/home-global-leader-sixth-street.svg', 'Sixth Street'],
        ['/assets/images/home-global-leader-super-she-icon.svg', 'Super She'],
        ['/assets/images/home-global-leader-hardees-icon.svg', 'Hardees'],
        ['/assets/images/home-global-leader-empire-hotels-icon.svg', 'Empire Hotels'],
        ['/assets/images/home-global-leader-american-express.svg', 'AmEx'],
        ['/assets/images/ikea-home-logo.svg', 'IKEA'],
      ].map(([src, alt]) => (
        <div class="flex items-center justify-center shrink-0 h-14 px-7 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:border-[#FF5B2E]/30 transition-colors duration-300 group cursor-default">
          <img
            src={src}
            alt={alt}
            class="max-h-6 max-w-[100px] w-auto h-auto object-contain filter grayscale group-hover:grayscale-0 opacity-60 group-hover:opacity-100 transition-all duration-400"
            onerror="this.closest('div').style.display='none'"
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Stat strip -->
  <div class="container-xl mt-14">
    <div class="reveal grid grid-cols-2 lg:grid-cols-4 divide-x divide-white/[0.06] rounded-2xl border border-white/[0.06] overflow-hidden bg-[#0d1017]">
      {[
        { v: '40+',     l: 'Fortune 500 Clients' },
        { v: '3,000+',  l: 'Products Delivered' },
        { v: '35+',     l: 'Countries Active' },
        { v: '99.99%',  l: 'Production Uptime SLA' },
      ].map(({ v, l }) => (
        <div class="px-6 py-8 text-center lg:text-left">
          <div class="text-3xl lg:text-4xl font-black text-white mb-1">{v}</div>
          <div class="text-caption text-gray-500">{l}</div>
        </div>
      ))}
    </div>
  </div>

</section>
