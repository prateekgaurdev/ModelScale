---
// ChangelogTeaser.astro — NEW. Blog / changelog cards.
const posts = [
  { pill: 'v1.4 · Launch',   date: 'Sep 2026', title: 'The AI Voice Agent v1.4 — sub-300ms latency arrives',   desc: 'A rewrite of our turn-taking model brings inbound latency from 380ms to 288ms — indistinguishable from a human.' },
  { pill: 'Playbook',        date: 'Aug 2026', title: 'How we built Kestrel Bank\'s fraud copilot in 7 weeks', desc: 'The exact architecture, the six eval sets we ran, and what we\'d change if we shipped it today.' },
  { pill: 'Engineering',     date: 'Aug 2026', title: 'Why "durable execution" is the AI feature nobody markets', desc: 'Multi-agent workflows fail without state that survives a browser refresh. Here\'s how we solved it.' },
];
---

<section id="blog" class="ms-log">
  <div class="container-lg">
    <div class="ms-sh">
      <div class="reveal">
        <div class="kicker">[ 012 · Field notes ]</div>
        <h2 class="line-anim">
          <span>What we're <em>shipping</em></span>
          <span>and learning.</span>
        </h2>
      </div>
      <p class="reveal delay-2 lede">A working log from the pods. Playbooks, launches, technical write-ups.</p>
    </div>

    <div class="ms-log-grid">
      {posts.map((p, i) => (
        <a href="#" class={`ms-log-card reveal delay-${i+1}`}>
          <div class="ms-log-meta">
            <span class="pill">{p.pill}</span>
            <span>{p.date}</span>
          </div>
          <div class="ms-log-title">{p.title}</div>
          <div class="ms-log-desc">{p.desc}</div>
          <div class="ms-log-link">Read post
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ms-log { padding: clamp(80px, 10vw, 140px) 0; border-top: 1px solid var(--rule); background: var(--paper); }
  .ms-sh { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 32px; }
  @media (max-width: 900px) { .ms-sh { grid-template-columns: 1fr; } }
  .ms-sh .kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
  .ms-sh h2 { font-family: var(--font-display); font-size: clamp(2.25rem, 4.5vw, 4rem); line-height: 0.98; letter-spacing: -0.025em; }
  .ms-sh h2 span { display: block; }
  .ms-sh h2 em { font-style: italic; color: var(--accent); }
  .ms-sh .lede { color: var(--ink-2); font-size: 1.05rem; line-height: 1.6; max-width: 46ch; }

  .ms-log-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  @media (max-width: 900px) { .ms-log-grid { grid-template-columns: 1fr; } }
  .ms-log-card { background: #FDFCF9; border: 1px solid var(--rule); border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 14px; min-height: 260px; transition: transform .3s var(--spring), border-color .3s ease; }
  .ms-log-card:hover { transform: translateY(-4px); border-color: var(--rule-strong); }
  .ms-log-meta { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-3); }
  .ms-log-meta .pill { padding: 4px 10px; border-radius: 999px; background: var(--paper-2); border: 1px solid var(--rule); color: var(--ink); }
  .ms-log-title { font-family: var(--font-display); font-size: 1.5rem; letter-spacing: -0.015em; line-height: 1.1; }
  .ms-log-desc { color: var(--ink-2); font-size: 14px; line-height: 1.55; }
  .ms-log-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); margin-top: auto; display: inline-flex; align-items: center; gap: 8px; }
</style>
