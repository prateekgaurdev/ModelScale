---
// PricingTiers.astro — NEW. Three-tier engagement pricing.
const tiers = [
  { name: 'Pilot', price: '$18k', per: '/ 4 weeks',
    desc: 'One production-grade AI workflow. Perfect for validating a bet.',
    list: ['1 flagship workflow (voice or LinkedIn)', 'Custom eval harness + report', 'Deployment in your VPC', 'Slack channel with the pod', 'Two weekly principal reviews'] },
  { name: 'Scale', price: '$42k', per: '/ month', badge: 'Most engaged', featured: true,
    desc: 'A cross-functional pod embedded with your team. Ship monthly.',
    list: ['3–5 engineers + 1 principal', 'Both flagship products included', 'On-call SRE rotation', 'Weekly evaluation report', 'Roadmap co-owned with your PM', 'Dedicated CRM & telemetry integration'] },
  { name: 'Enterprise', price: 'Custom', per: '',
    desc: 'Multi-team engagement with dedicated infra and compliance envelope.',
    list: ['Air-gapped VPC / on-prem deploy', 'SOC 2 Type II mapped controls', 'Dedicated fine-tuning cluster', '24/7 incident response with 15-min SLA', 'Quarterly executive strategy sessions', 'Named CTO advisor'] },
];
---

<section id="pricing" class="ms-pricing">
  <div class="container-lg">
    <div class="ms-sh">
      <div class="reveal">
        <div class="kicker">[ 007 · Pricing ]</div>
        <h2 class="line-anim">
          <span>Engagement that <em>scales</em></span>
          <span>with the bet.</span>
        </h2>
      </div>
      <p class="reveal delay-2 lede">Fixed-scope pilots to embedded pods. Everything transparent. Everything terminable in 30 days.</p>
    </div>

    <div class="ms-tiers">
      {tiers.map((t) => (
        <div class={`ms-tier reveal ${t.featured ? 'featured' : ''}`}>
          {t.badge && <span class="ms-tier-badge">{t.badge}</span>}
          <div>
            <div class="ms-tier-name">{t.name}</div>
            <div class="ms-tier-desc">{t.desc}</div>
          </div>
          <div class="ms-tier-price">{t.price}<small>{t.per}</small></div>
          <ul class="ms-tier-list">
            {t.list.map((x) => <li>{x}</li>)}
          </ul>
          <button
            class={`swap-text-button ${t.featured ? 'btn-primary-blue' : 'btn-primary-blue'} ms-tier-cta`}
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal',{detail:{source:'pricing-tier'}}))"
          >
            <span class="text-original"><span>{t.featured ? 'Talk to a principal →' : 'Get started →'}</span></span>
            <span class="text-hover"><span>{t.featured ? 'Talk to a principal →' : 'Get started →'}</span></span>
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ms-pricing { padding: clamp(80px, 10vw, 140px) 0; border-top: 1px solid var(--rule); background: var(--paper); }
  .ms-sh { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 32px; }
  @media (max-width: 900px) { .ms-sh { grid-template-columns: 1fr; } }
  .ms-sh .kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; }
  .ms-sh h2 { font-family: var(--font-display); font-size: clamp(2.25rem, 4.5vw, 4rem); line-height: 0.98; letter-spacing: -0.025em; }
  .ms-sh h2 span { display: block; }
  .ms-sh h2 em { font-style: italic; color: var(--accent); }
  .ms-sh .lede { color: var(--ink-2); font-size: 1.05rem; line-height: 1.6; max-width: 46ch; }

  .ms-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
  @media (max-width: 900px) { .ms-tiers { grid-template-columns: 1fr; } }
  .ms-tier { position: relative; background: #FDFCF9; border: 1px solid var(--rule); border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 20px; transition: transform .3s var(--spring), box-shadow .3s ease; }
  .ms-tier:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgba(11,11,13,0.15); }
  .ms-tier.featured { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .ms-tier.featured .ms-tier-desc { color: rgba(255,255,255,0.7); }
  .ms-tier.featured .ms-tier-price { color: var(--paper); }
  .ms-tier.featured .ms-tier-list li { color: rgba(255,255,255,0.85); }
  .ms-tier-badge { position: absolute; top: -12px; left: 24px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; background: var(--accent); color: #fff; }
  .ms-tier-name { font-family: var(--font-display); font-size: 1.75rem; letter-spacing: -0.015em; }
  .ms-tier-desc { color: var(--ink-2); font-size: 14px; line-height: 1.55; min-height: 42px; }
  .ms-tier-price { font-family: var(--font-display); font-size: 3.25rem; line-height: 1; letter-spacing: -0.03em; color: var(--ink); }
  .ms-tier-price small { font-family: var(--font-ui); font-size: 14px; color: var(--ink-3); font-weight: 400; margin-left: 4px; }
  .ms-tier-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14px; }
  .ms-tier-list li { display: flex; gap: 10px; align-items: flex-start; }
  .ms-tier-list li::before { content: ''; width: 16px; height: 16px; border-radius: 50%; background: var(--paper-3); background-image: radial-gradient(circle at 50% 50%, var(--accent) 2.5px, transparent 3px); display: inline-block; margin-top: 3px; flex-shrink: 0; }
  .ms-tier.featured .ms-tier-list li::before { background: rgba(255,255,255,0.14); background-image: radial-gradient(circle at 50% 50%, var(--accent) 3px, transparent 3.5px); }
  .ms-tier-cta { width: 100%; justify-content: center; padding: 12px 18px; }
</style>
