---
import { Trophy, Award, Star, ExternalLink } from 'lucide-react';

const awardsList = [
  {
    year: '2026',
    organization: 'The Economic Times',
    title: 'Leader in AI-First Product Engineering',
    category: 'AI & Enterprise Transformation',
    icon: '/assets/images/economic-times-2023-badge.svg',
    highlight: 'Recognized for pioneering Agentic AI and multi-agent RAG implementations in Fortune 500 enterprises.'
  },
  {
    year: '2025',
    organization: 'Deloitte Tech Fast 50',
    title: 'Top 50 Fastest Growing Technology Companies',
    category: 'Rapid Enterprise Growth',
    icon: '/assets/images/deloitte-tech-fast-50.svg',
    highlight: 'Consecutive ranking celebrating over 400% revenue growth and international expansion across 4 continents.'
  },
  {
    year: '2026',
    organization: 'Clutch Global Awards',
    title: 'Global Leader in Custom Software Development',
    category: 'Client Satisfaction',
    icon: '/assets/images/clutch-2025-badge.svg',
    highlight: 'Rated 4.9/5 based on verified reviews by C-suite executives and venture-backed founders.'
  },
  {
    year: '2025',
    organization: 'Times Business Awards',
    title: 'Industry Change Maker in Digital Innovation',
    category: 'Excellence in Engineering',
    icon: '/assets/images/business-award-modal-logo.svg',
    highlight: 'Awarded for architecting high-scale digital commerce and logistics systems.'
  },
  {
    year: '2024 - 2025',
    organization: 'CIO 100 Innovator',
    title: 'Excellence in Cloud & Modernization Architecture',
    category: 'Cloud Engineering',
    icon: '/assets/images/cio-badge-award.svg',
    highlight: 'Honored for zero-downtime legacy application modernization and cloud migration frameworks.'
  }
];
---

<section id="awards" class="py-24 bg-black relative border-t border-white/10 overflow-hidden">
  
  {/* Ambient Glow */}
  <div class="absolute top-1/2 left-1/4 w-[500px] h-[500px] bg-yellow-500/5 blur-[160px] rounded-full pointer-events-none" />

  <div class="layout-container-lg relative z-10">
    
    <div class="max-w-3xl mx-auto text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-bold text-modelscale-yellow uppercase tracking-wider mb-4">
        <Trophy className="w-3.5 h-3.5" />
        <span>Accreditations & Honors</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold line-anim text-white tracking-tight leading-tight">
        Proven Engineering Excellence, <br />
        <span class="bg-gradient-to-r from-amber-300 via-yellow-200 to-white bg-clip-text text-transparent">
          Globally Accredited.
        </span>
      </h2>
      <p class="mt-4 text-base text-gray-400 font-normal max-w-xl mx-auto">
        Our commitment to uncompromising code quality, reliable delivery, and breakthrough AI innovation is consistently recognized by leading industry bodies.
      </p>
    </div>

    {/* Awards Timeline List */}
    <div class="space-y-4">
      {awardsList.map((item, idx) => (
        <div class="p-6 sm:p-8 rounded-2xl bg-[#0d1017] border border-white/10 hover:border-yellow-400/40 transition-all duration-300 flex flex-col md:flex-row md:items-center justify-between gap-6 group hover:-translate-y-0.5">
          
          <div class="flex items-start sm:items-center gap-4">
            <div class="w-16 h-16 rounded-xl bg-black/80 border border-white/15 p-2 flex items-center justify-center shrink-0 group-hover:border-yellow-400/30 transition-colors">
              <img 
                src={item.icon} 
                alt={item.organization}
                class="w-full h-full object-contain filter brightness-125"
                onError={(e) => {
                  (e.currentTarget as HTMLElement).style.display = 'none';
                }}
              />
            </div>
            
            <div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-bold text-modelscale-yellow uppercase tracking-wider font-mono">
                  {item.organization}
                </span>
                <span class="text-xs font-mono text-gray-400 px-2 py-0.5 rounded bg-white/5">
                  {item.year}
                </span>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-white mt-1 group-hover:text-amber-200 transition-colors">
                {item.title}
              </h3>
              <p class="text-xs sm:text-sm text-gray-400 mt-1 max-w-2xl font-normal">
                {item.highlight}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4 shrink-0 self-end md:self-center">
            <span class="text-xs font-mono text-gray-400 bg-white/5 px-3 py-1.5 rounded-lg border border-white/5">
              {item.category}
            </span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
