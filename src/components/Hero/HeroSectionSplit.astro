---
// HeroSectionSplit.astro — v2 hero: headline + LinkedIn Automater tile.
import GradientCanvas from '../Motion/GradientCanvas.astro';
---

<section id="hero" class="ms-hero-split">
  <GradientCanvas intensity={0.7} />
  <div class="container-xl ms-split-inner">
    <div class="ms-split-copy">
      <div class="ms-eb-pill"><span class="pulse-dot"/> Featured launch — v1.4</div>
      <h1 class="ms-split-h1 reveal line-anim">
        <span>The AI team</span>
        <span>behind your next</span>
        <span><em>ten releases.</em></span>
      </h1>
      <p class="reveal delay-2 ms-split-lead">
        We build LinkedIn Post Automaters, AI voice-calling agents and enterprise
        multi-agent networks that plug straight into your CRM, ERP and cloud telemetry.
      </p>
      <div class="ms-hero-ctas">
        <button class="swap-text-button btn-primary-blue ms-magnet"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal',{detail:{source:'hero-v2-cta'}}))">
          <span class="text-original"><span>Book a strategy call</span></span>
          <span class="text-hover"><span>Book a strategy call</span></span>
        </button>
        <a href="#pricing" class="swap-text-button transparent-wht-btn ms-magnet">
          <span class="text-original"><span class="blk-text">See pricing</span></span>
          <span class="text-hover"><span class="blk-text">See pricing</span></span>
        </a>
      </div>
    </div>

    <div class="ms-split-demo reveal delay-2">
      <div class="li-post">
        <div class="li-head">
          <div class="li-avatar">MS</div>
          <div>
            <div class="li-name">ModelScale · Draft #1</div>
            <div class="li-sub">Auto-scheduled for 9:12 AM · Public</div>
          </div>
          <div class="mono-label" style="margin-left:auto;color:var(--accent)">◉ Live</div>
        </div>
        <div class="li-body" id="msTypeTarget"><span class="cursor"></span></div>
        <div class="li-metrics">
          <span>👍 1.2k</span><span>💬 84</span><span>🔁 32</span>
          <span style="margin-left:auto;color:var(--accent)">◉ Scheduled</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ms-hero-split { position: relative; min-height: 100dvh; padding: 140px 0 60px; overflow: hidden; background: var(--paper); }
  .ms-split-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 1fr; gap: 3rem; align-items: center; min-height: calc(100dvh - 200px); }
  @media (max-width: 1000px) { .ms-split-inner { grid-template-columns: 1fr; } }
  .ms-eb-pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px 6px 10px; border: 1px solid var(--rule-strong); border-radius: 999px;
    background: rgba(255,255,255,0.6); backdrop-filter: blur(10px);
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink); margin-bottom: 24px;
  }
  .ms-split-h1 {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 6.5rem); line-height: 0.9;
    letter-spacing: -0.03em; color: var(--ink);
  }
  .ms-split-h1 span { display: block; }
  .ms-split-h1 em { font-style: italic; color: var(--accent); }
  .ms-split-lead { font-size: clamp(1.05rem, 1.1vw + 0.5rem, 1.35rem); line-height: 1.55; color: var(--ink-2); margin-top: 28px; max-width: 46ch; }
  .ms-hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }

  .li-post {
    background: #fff; border: 1px solid var(--rule-strong); border-radius: 16px;
    padding: 22px; max-width: 520px; margin-left: auto;
    box-shadow: 0 30px 80px -40px rgba(11,11,13,0.25);
  }
  .li-head { display: flex; gap: 10px; align-items: center; margin-bottom: 14px; }
  .li-avatar { width: 44px; height: 44px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #F2C4A6);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-family: var(--font-display); font-size: 20px; }
  .li-name { font-weight: 600; font-size: 14px; }
  .li-sub  { font-size: 12px; color: var(--ink-3); }
  .li-body { font-size: 14px; line-height: 1.55; color: var(--ink); white-space: pre-wrap; min-height: 110px; }
  .li-body .cursor { display: inline-block; width: 8px; height: 16px; background: var(--ink); vertical-align: -3px; margin-left: 2px; animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .li-metrics { display: flex; gap: 16px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--rule); font-size: 12px; color: var(--ink-3); }
</style>

<script>
  const POSTS = [
    "Just shipped: our AI voice agent handles inbound qualification calls in 12 languages with human-parity latency (< 380 ms).\n\nThree things that made it work →\n\n1. Streaming ASR + custom TTS keeps interruptions natural.\n2. RAG on the CRM keeps context alive across follow-ups.\n3. A supervisor agent handles the last-mile handoff to humans.",
    "We audited 43 enterprise AI pilots this quarter.\n\n72% never made it past sandbox because they skipped one thing: a durable execution layer.\n\nIf your agent forgets what happened after a browser refresh, it's a demo — not a system.",
  ];
  const el = document.getElementById('msTypeTarget');
  if (el) {
    let idx = 0;
    let t: any = null;
    let isVisible = true;

    const play = () => {
      if (!isVisible) return;
      const text = POSTS[idx];
      let i = 0;
      el.innerHTML = '<span class="cursor"></span>';
      clearInterval(t);
      t = setInterval(() => {
        if (!isVisible) return;
        i += 2;
        el.textContent = text.slice(0, i);
        const c = document.createElement('span'); c.className = 'cursor'; el.appendChild(c);
        if (i >= text.length) {
          clearInterval(t);
          setTimeout(() => { idx = (idx + 1) % POSTS.length; play(); }, 3400);
        }
      }, 28);
    };

    const heroObs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        isVisible = e.isIntersecting;
        if (isVisible && !t) {
          play();
        } else if (!isVisible && t) {
          clearInterval(t);
          t = null;
        }
      });
    }, { threshold: 0.1 });
    heroObs.observe(el);
  }

  // Optimized magnetic buttons
  document.querySelectorAll<HTMLElement>('.ms-magnet').forEach((el) => {
    let raf = 0;
    el.addEventListener('pointermove', (e: PointerEvent) => {
      const r = el.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) * 0.22;
      const dy = (e.clientY - (r.top + r.height / 2)) * 0.22;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => { el.style.transform = `translate3d(${dx}px, ${dy}px, 0)`; });
    }, { passive: true });
    el.addEventListener('pointerleave', () => {
      cancelAnimationFrame(raf);
      el.style.transform = 'translate3d(0,0,0)';
    }, { passive: true });
    el.style.transition = 'transform .25s cubic-bezier(0.22,1,0.36,1)';
  });
</script>
