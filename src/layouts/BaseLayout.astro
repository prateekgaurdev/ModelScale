---
import Navbar from '../components/Header/Navbar.tsx';
import Footer from '../components/Footer/Footer.astro';
import ContactModal from '../components/Modals/ContactModal.tsx';
import ExitIntentModal from '../components/Modals/ExitIntentModal.tsx';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ModelScale | Digital Product Engineering & AI Consulting',
  description = 'ModelScale is a global digital product engineering and AI consulting company. We deliver 3,000+ mission-critical products for Fortune 500 enterprises worldwide.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='2' y='2' width='18' height='18' rx='6' fill='%23FF5B2E' /><rect x='12' y='12' width='18' height='18' rx='6' fill='%230B0B0D' fill-opacity='0.9' /></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body>
    <!-- Shared ambient glow layer (hardware-accelerated radial glow) -->
    <div class="ambient-layer" aria-hidden="true">
      <div class="ambient-orb" style="width:900px;height:700px;background:radial-gradient(circle, rgba(255,91,46,0.06) 0%, transparent 70%);top:-240px;left:50%;transform:translateX(-50%);"></div>
      <div class="ambient-orb" style="width:600px;height:600px;background:radial-gradient(circle, rgba(184,199,232,0.12) 0%, transparent 70%);top:60vh;left:-160px;"></div>
      <div class="ambient-orb" style="width:500px;height:500px;background:radial-gradient(circle, rgba(242,196,166,0.1) 0%, transparent 70%);top:140vh;right:-128px;"></div>
    </div>

    <Navbar client:load />

    <main>
      <slot />
    </main>

    <Footer />

    <ContactModal client:load />
    <ExitIntentModal client:load />

    <script>
      /**
       * ModelScale Animation & Featherlight Scroll Engine
       * ─────────────────────────────────────────────────────────────────
       * 1. Lenis smooth scroll: ultra-responsive, natural momentum
       * 2. GSAP ScrollTrigger integration via lenis.on("scroll")
       * 3. .line-anim per-character text reveal (GSAP stagger)
       * 4. .reveal IntersectionObserver entry animations
       * 5. Smooth natural card reveals (zero scroll hijacking / no jarring pins)
       * 6. Scoped mouse followers for portfolio & testimonials
       * 7. Seamless anchor click gliding
       * ─────────────────────────────────────────────────────────────────
       */
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import Lenis from "@studio-freight/lenis";

      gsap.registerPlugin(ScrollTrigger);

      // ── Scroll-to-top before anything else ───────────────────────────
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
      document.documentElement.scrollTop = 0;
      document.body.scrollTop = 0;

      // ── 1. LENIS — Featherlight, Natural, Silky Smooth ────────────────
      const lenis = new Lenis({
        smoothWheel: true,
        syncTouch: false,
        lerp: 0.09, // Natural, featherlight momentum easing
        orientation: "vertical",
        gestureOrientation: "vertical",
        touchMultiplier: 1.0, // 1:1 natural touch physics (not artificial)
        wheelMultiplier: 1.0,
        infinite: false,
        autoResize: true,
      });

      // Expose on window so React components can access synchronously
      window.__lenis = lenis;
      window.__gsap  = gsap;
      window.__ST    = ScrollTrigger;

      // ── GSAP + Lenis integration ──────────────────────────────────────
      lenis.on("scroll", () => ScrollTrigger.update());

      // Drive Lenis from GSAP ticker with graceful lag smoothing
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(500, 33);

      // Sync ScrollTrigger resize with Lenis
      ScrollTrigger.addEventListener("refresh", () => lenis.resize());

      // Scroll to top once everything has rendered
      window.addEventListener("load", () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            window.scrollTo({ top: 0, left: 0, behavior: "instant" });
            lenis.scrollTo(0, { immediate: true, force: true });
            ScrollTrigger.clearScrollMemory();
            ScrollTrigger.refresh(true);
          });
        });
      });

      // ── 2. Seamless Anchor Click Gliding ──────────────────────────────
      document.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement)?.closest?.('a[href^="#"]');
        if (!target) return;
        const href = target.getAttribute("href");
        if (!href || href === "#" || href.length < 2) return;
        const dest = document.querySelector(href);
        if (dest) {
          e.preventDefault();
          lenis.scrollTo(dest as HTMLElement, { offset: -70, duration: 0.9 });
        }
      });

      // ── 3. .reveal — Fast, Snappy IntersectionObserver ───────────────
      function initReveal() {
        const targets = document.querySelectorAll(".reveal, .reveal-blur, .reveal-scale");
        if (!targets.length) return;
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }),
          { threshold: 0.05, rootMargin: "0px 0px -20px 0px" }
        );
        targets.forEach((el) => io.observe(el));
      }

      // ── 4. .line-anim — per-character GSAP stagger ───────────────────
      function initLineAnimations() {
        document.querySelectorAll(".line-anim").forEach((heading) => {
          const el = heading as HTMLElement;
          if (el.dataset.lineAnimDone) return;
          el.dataset.lineAnimDone = "1";

          el.querySelectorAll("span").forEach((lineSpan) => {
            const walker = document.createTreeWalker(lineSpan, NodeFilter.SHOW_TEXT);
            const textNodes: Node[] = [];
            let node: Node | null;
            while ((node = walker.nextNode())) {
              if (node.nodeValue?.trim()) textNodes.push(node);
            }
            textNodes.forEach((textNode) => {
              const parent = textNode.parentNode;
              const text   = textNode.nodeValue || "";
              const frag   = document.createDocumentFragment();

              // Desktop: per character. Mobile: per word.
              if (window.innerWidth <= 767) {
                text.split(" ").forEach((word, i, arr) => {
                  const s = document.createElement("span");
                  s.textContent = word;
                  s.style.display = "inline-block";
                  frag.appendChild(s);
                  if (i < arr.length - 1) frag.appendChild(document.createTextNode(" "));
                });
              } else {
                [...text].forEach((char) => {
                  const s = document.createElement("span");
                  s.textContent = char === " " ? "\u00A0" : char;
                  s.style.display = "inline-block";
                  frag.appendChild(s);
                });
              }
              parent?.replaceChild(frag, textNode);
            });
          });

          const chars = el.querySelectorAll("span span");
          if (!chars.length) return;

          gsap.fromTo(chars,
            { y: 10, opacity: 0 },
            {
              y: 0, opacity: 1,
              stagger: 0.006,
              ease: "power2.out",
              duration: 0.22,
              scrollTrigger: {
                trigger: el,
                start: "top 88%",
                once: true,
              },
            }
          );
        });
      }

      // ── 5. Services — Fluid Stagger (No Pin / No Scroll Hijacking) ────
      function initServicesReveal() {
        const cards = document.querySelectorAll(".service-card-hz");
        const btn = document.querySelector(".services-view-all");
        if (!cards.length) return;

        cards.forEach((card, i) => {
          gsap.fromTo(card,
            { y: 25, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.45,
              delay: i * 0.08,
              ease: "power2.out",
              scrollTrigger: {
                trigger: card,
                start: "top 90%",
                once: true
              }
            }
          );
        });

        if (btn) {
          gsap.fromTo(btn,
            { y: 15, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              duration: 0.4,
              ease: "power2.out",
              scrollTrigger: {
                trigger: btn,
                start: "top 92%",
                once: true
              }
            }
          );
        }
      }

      // ── 6. Scoped Mouse Followers (Zero Global Overhead) ──────────────
      function initMouseFollowers() {
        // Portfolio DRAG follower
        const portSection  = document.querySelector(".portfolio-section") as HTMLElement | null;
        const portFollower = document.querySelector(".portfolio-follower") as HTMLElement | null;
        if (portSection && portFollower) {
          let rafId: number | null = null;
          let inside = false;
          gsap.set(portFollower, { xPercent: -50, yPercent: -50, scale: 0, opacity: 0 });

          const show = () => gsap.to(portFollower, { scale: 1, opacity: 1, duration: 0.25, ease: "power2.out" });
          const hide = () => gsap.to(portFollower, { scale: 0, opacity: 0, duration: 0.2, ease: "power2.out" });

          portSection.addEventListener("pointerenter", () => { inside = true; show(); }, { passive: true });
          portSection.addEventListener("pointerleave", () => { inside = false; hide(); }, { passive: true });
          portSection.addEventListener("pointermove", (e: PointerEvent) => {
            if (!inside) { inside = true; show(); }
            const rect = portSection.getBoundingClientRect();
            if (rafId) cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(() => {
              gsap.to(portFollower, { x: e.clientX - rect.left, y: e.clientY - rect.top, duration: 0.35, ease: "power3.out" });
            });
          }, { passive: true });
        }

        // Testimonials arrow follower
        const testRight   = document.querySelector(".testimonials-right") as HTMLElement | null;
        const testFollow  = document.querySelector(".testimonial-mouse-follower") as HTMLElement | null;
        const testArrow   = testFollow?.querySelector("svg");
        if (testRight && testFollow && testArrow) {
          let rafId2: number | null = null;
          let inside2 = false;
          gsap.set(testFollow, { xPercent: -50, yPercent: -50, scale: 0, opacity: 0 });

          const show2 = () => gsap.to(testFollow, { scale: 1, opacity: 1, duration: 0.25, ease: "power2.out" });
          const hide2 = () => gsap.to(testFollow, { scale: 0, opacity: 0, duration: 0.2, ease: "power2.out" });

          testRight.addEventListener("pointerenter", () => { inside2 = true; show2(); }, { passive: true });
          testRight.addEventListener("pointerleave", () => { inside2 = false; hide2(); }, { passive: true });
          testRight.addEventListener("pointermove", (e: PointerEvent) => {
            if (!inside2) { inside2 = true; show2(); }
            const rect = testRight.getBoundingClientRect();
            const mid = rect.top + rect.height / 2;
            gsap.to(testArrow, { rotation: e.clientY < mid ? 0 : 180, duration: 0.15, ease: "power2.out" });
            if (rafId2) cancelAnimationFrame(rafId2);
            rafId2 = requestAnimationFrame(() => {
              gsap.to(testFollow, { x: e.clientX - rect.left, y: e.clientY - rect.top, duration: 0.35, ease: "power3.out" });
            });
          }, { passive: true });
        }
      }

      // ── 7. Parallax Effects ───────────────────────────────────────────
      function initParallax() {
        const portImages = document.querySelectorAll(".port-card-img");
        portImages.forEach((img) => {
          gsap.fromTo(img, 
            { yPercent: -8 },
            { 
              yPercent: 8,
              ease: "none",
              scrollTrigger: {
                trigger: img.parentElement,
                start: "top bottom",
                end: "bottom top",
                scrub: true
              }
            }
          );
        });
      }

      // ── Run all ───────────────────────────────────────────────────────
      function runAll() {
        initReveal();
        initLineAnimations();
        initServicesReveal();
        initMouseFollowers();
        initParallax();
        setTimeout(() => ScrollTrigger.refresh(), 300);
      }

      if (document.readyState === "complete") {
        runAll();
      } else {
        window.addEventListener("load", runAll);
      }
    </script>
  </body>
</html>
